# =====================================================
# Co-Piloto Braziliana — Variáveis de Ambiente
# =====================================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Site Braziliana
BRAZILIANA_BASE_URL=https://brazilianashop.com.br

# Servidor
PORT=3000
CORS_ORIGIN=https://brazilianashop.com.br

# Banco de dados MySQL (para workers e logs)
DB_HOST=localhost
DB_USER=novobr
DB_PASSWORD=
DB_NAME=novobr

# Câmbio e limites
CAMBIO_USD_BRL=5.80
MAX_MSGS_POR_MINUTO=20
TIMEOUT_CLAUDE_MS=15000
TIMEOUT_SITE_MS=8000

# Gateways de pagamento (para reembolso)
STRIPE_SECRET_KEY=sk_live_...
APPMAX_API_KEY=...
APPMAX_BASE_URL=https://api.appmax.com.br

# Admin
BRAZILIANA_ADMIN_TOKEN=...

# Cache de documentos
CACHE_DOCUMENTOS_TTL_MS=1800000

# Embeddings (para conteúdo de referência)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Conteúdo
CONTEUDO_CHUNK_TOKENS=800
CONTEUDO_CHUNK_OVERLAP=100
CONTEUDO_TOP_K=3

# Cron embutido (1=ativar cron dentro do server, 0=rodar separado via npm run cron)
CRON_EMBEDDED=1

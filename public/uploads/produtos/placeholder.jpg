<?php
// Arquivo placeholder para evitar 404
// Retorna uma imagem transparente 1x1
header('Content-Type: image/jpeg');
header('Cache-Control: no-cache, no-store, must-revalidate');
header('Pragma: no-cache');
header('Expires: 0');

// Log para debug
error_log(' [PLACEHOLDER-DEBUG] Acesso em: ' . $_SERVER['REQUEST_URI']);
error_log(' [PLACEHOLDER-DEBUG] Referer: ' . ($_SERVER['HTTP_REFERER'] ?? 'N/A'));
error_log(' [PLACEHOLDER-DEBUG] User Agent: ' . ($_SERVER['HTTP_USER_AGENT'] ?? 'N/A'));
error_log(' [PLACEHOLDER-DEBUG] IP: ' . ($_SERVER['REMOTE_ADDR'] ?? 'N/A'));
error_log(' [PLACEHOLDER-DEBUG] Método: ' . ($_SERVER['REQUEST_METHOD'] ?? 'N/A'));

// Imagem JPEG 1x1 transparente
echo base64_decode('');
?>
